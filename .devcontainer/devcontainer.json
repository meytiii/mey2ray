{
  "name": "Mey2Ray",
  "build": {
    "dockerfile": "./Dockerfile",
    "context": "."
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": false
    },
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "latest"
    }
  },
  "postAttachCommand": {
    "public": "gh codespace ports visibility 443:public -c $CODESPACE_NAME 2>/dev/null || true",
    "info": "/usr/local/bin/show-info.sh"
  },
  "portsAttributes": {
    "443": {
      "label": "mey2ray-proxy",
      "protocol": "http",
      "onAutoForward": "silent"
    }
  },
  "forwardPorts": [443],
  "hostRequirements": {
    "cpus": 2
  }
}